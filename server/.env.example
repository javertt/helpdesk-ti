# Local: as duas URLs podem ser iguais. No Supabase, use Transaction pooler
# (porta 6543) em DATABASE_URL e Session pooler (porta 5432) em MIGRATION_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_ti?schema=public"
MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_ti?schema=public"
JWT_SECRET="substitua-por-uma-chave-longa-e-aleatoria-com-pelo-menos-32-caracteres"
PORT=3001
CLIENT_URL="http://localhost:5173"
